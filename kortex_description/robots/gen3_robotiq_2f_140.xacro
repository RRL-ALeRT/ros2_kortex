<?xml version="1.0"?>

<robot name="gen3_robotiq_2f_140" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Arguments -->
    <xacro:arg name="arm" default="gen3" />
    <xacro:arg name="dof" default="6" />
    <xacro:arg name="vision" default="true" />

    <xacro:arg name="gripper" default="robotiq_2f_140" />
    <xacro:arg name="use_internal_bus_gripper_comm" default="false" />
    <xacro:arg name="gripper_com_port" default="/dev/ttyUSB0" />

    <xacro:arg name="prefix" default="" />

    <xacro:include filename="$(find kortex_description)/robots/kortex_robot.xacro" />
    <xacro:load_robot
      parent="base_link"
      arm="$(arg arm)"
      gripper="$(arg gripper)"
      gripper_joint_name="gripper_base_joint"
      dof="$(arg dof)"
      vision="$(arg vision)"
      robot_ip="192.168.50.9"  
      username="admin"
      password="admin"
      port="10000"
      port_realtime="10001"
      session_inactivity_timeout_ms="30000"
      connection_inactivity_timeout_ms="30000"
      prefix="$(arg prefix)"
      use_internal_bus_gripper_comm="$(arg use_internal_bus_gripper_comm)"
      gripper_com_port="$(arg gripper_com_port)">
    </xacro:load_robot>


</robot>
